#!/bin/sh
# Applied once on first boot. Do not repartition or format any storage here.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "jdcloud,re-ss-01" ] || exit 0
# 25.12 stores the netmask in ipaddr; a bare address is parsed as /32.
lan_ip="$(uci -q get network.lan.ipaddr)"
lan_netmask="$(uci -q get network.lan.netmask)"
if [ "$(uci -q get network.lan.proto)" = 'static' ]; then
	case "$lan_ip:$lan_netmask" in
		'192.168.1.1/24:'|'192.168.1.1:255.255.255.0'|'192.168.233.1:')
			uci set network.lan.ipaddr='192.168.233.1/24'
			;;
	esac
fi
# Leave an administrator's other LAN address/prefix intact on upgrades.
uci set system.@system[0].hostname='Arthur'
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].timezone='CST-8'
uci commit network
uci commit system
if [ -x /usr/bin/zsh ]; then
	sed -i '/^root:/s|:[^:]*$|:/usr/bin/zsh|' /etc/passwd
	grep -q '^PROMPT=' /etc/zsh/zprofile 2>/dev/null || \
		printf '%s\n' 'PROMPT="%F{green}%n@%m%f:%F{blue}%~%f$ "' >> /etc/zsh/zprofile
fi
if [ -f /usr/share/vim/vimrc ] && [ ! -f /usr/share/vim/defaults.vim ]; then
	cp /usr/share/vim/vimrc /usr/share/vim/defaults.vim
fi
uci -q set ttyd.@ttyd[0].command='/bin/login -f root'
uci -q commit ttyd
# Fresh installations/reset leave Docker stopped; retain an explicit opt-in.
if [ -x /etc/init.d/dockerd ]; then
	case "$(uci -q get dockerd.globals.auto_start)" in
		''|0)
			/etc/init.d/dockerd disable
			uci set dockerd.globals.auto_start='0'
			uci commit dockerd
			;;
	esac
fi
# Keep Docker data on its upstream default until a data partition is mounted.
exit 0
