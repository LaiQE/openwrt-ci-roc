#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_instance() {
	local section="$1" enabled logger
	config_get_bool enabled "$section" enabled 0
	config_get_bool logger "$section" logger 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "$section"
	procd_set_param command /usr/bin/homebox serve
	procd_set_param respawn
	procd_set_param stdout "$logger"
	procd_set_param stderr "$logger"
	procd_close_instance
}

start_service() {
	config_load homebox
	config_foreach start_instance homebox
}

service_triggers() {
	procd_add_reload_trigger homebox
}
