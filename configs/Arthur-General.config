# Keep the original applications; Kconfig resolves their libraries and modules.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set
# These source feeds are compiled locally but have no public binary repository.
# Keep NSS packages selected; only omit the nonexistent APK index URLs.
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# Preserve the original shell, terminal policy and built-in utilities.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_LSUSB=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y
CONFIG_PACKAGE_git-lfs=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_zsh=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_net-tools-netstat=y
CONFIG_PACKAGE_net-tools-route=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_luci-theme-argon=y
# Argon 3.x includes its configuration UI; the old standalone app conflicts.
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# Networking, DNS filtering, VPN and remote access retained from the old seed.
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-tailscale=y
# DDNS-Go replaces the legacy DDNS service.
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
CONFIG_PACKAGE_luci-app-multi-frpc=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-wolplus=y
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_vlmcsd is not set
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-homebox=y
CONFIG_PACKAGE_luci-app-srun-autologin=y
# Built-in OAF, with filtering/access control/auditing off by default.
# Keep the management backend available to LuCI without disabling NSS.
CONFIG_PACKAGE_luci-app-oaf=y
# CONFIG_PACKAGE_luci-app-appfilter is not set
CONFIG_PACKAGE_appfilter=y
# CONFIG_PACKAGE_open-app-filter is not set
CONFIG_PACKAGE_kmod-oaf=y
# Retain the original optional multi-WAN package without putting it in rootfs.
CONFIG_PACKAGE_luci-app-mwan3=m
# dnsmasq-full is needed by PassWall; do not install conflicting variants.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# Follow the current PassWall defaults for the transparent proxy backend.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# Preserve the old optional Xray plugin without forcing it into the rootfs.
CONFIG_PACKAGE_xray-plugin=m

# TUIC and Hysteria2 require QUIC in Sing-box. Keep TLS fingerprints and gRPC.
CONFIG_SING_BOX_BUILD_QUIC=y
CONFIG_SING_BOX_BUILD_UTLS=y
CONFIG_SING_BOX_BUILD_GRPC=y
CONFIG_SING_BOX_BUILD_WIREGUARD=y
# The standalone Tailscale service already supplies this function.
# CONFIG_SING_BOX_BUILD_TAILSCALE is not set
