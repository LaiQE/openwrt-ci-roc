# JDCloud Arthur (RE-SS-01), 512 MiB RAM. Build only this device.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# Use the stable kernel supported by this branch (6.12), not testing 6.18.
# CONFIG_TESTING_KERNEL is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_IPQ_MEM_PROFILE_512=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
# LibWrt requires firmware 11.4 for ath11k Mesh NSS support.
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
# Enable Wi-Fi NSS at module load; configure WPA2 before testing wireless.
# Keep LibWrt's matching NSS drivers, firmware and ath11k patches together.

# All supported NSS managers for IPQ60xx; do not force upstream BROKEN modules.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_NSS_DRV_GRE_TUNNEL_ENABLE=y
CONFIG_NSS_DRV_IPV4_REASM_ENABLE=y
CONFIG_NSS_DRV_IPV6_REASM_ENABLE=y
CONFIG_NSS_DRV_LSO_RX_ENABLE=y

# PPP/L2TPv2 client with Qualcomm NSS acceleration support.
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_NSS_DRV_L2TP_ENABLE=y

# Container workloads and local eMMC management are required.
# Arthur-script.sh imports the maintained Lua Dockerman with a top-level menu.
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Restore upstream automount (existing filesystems only; no partition/format).
CONFIG_PACKAGE_automount=y
# No external QCN9074 radio or DSA switch on Arthur.
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set
# CONFIG_PACKAGE_kmod-dsa-qca8k is not set
# CONFIG_PACKAGE_kmod-phy-aquantia is not set
