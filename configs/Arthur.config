# JDCloud Arthur (RE-SS-01), 512 MiB RAM. Build only this device.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# Use the stable kernel supported by this branch (6.12), not testing 6.18.
# CONFIG_TESTING_KERNEL is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

# PPP/L2TPv2 client with Qualcomm NSS acceleration support.
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_NSS_DRV_L2TP_ENABLE=y

# Container workloads and local eMMC management are required.
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# Arthur has no USB ports: do not inherit unrelated board-wide USB defaults.
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# No external QCN9074 radio or DSA switch on Arthur.
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set
# CONFIG_PACKAGE_kmod-dsa-qca8k is not set
# CONFIG_PACKAGE_kmod-phy-aquantia is not set
